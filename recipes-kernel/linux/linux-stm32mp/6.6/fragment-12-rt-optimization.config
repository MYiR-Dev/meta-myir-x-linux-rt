# CONFIG_BT is not set
# CONFIG_WLAN is not set

# CPU1 is reserved by the myd-ld25x-rt kernel command line.  Stop its periodic
# scheduler tick and offload its RCU callbacks to the CPU0 housekeeping core.
# CONFIG_HZ_PERIODIC is not set
# CONFIG_NO_HZ_IDLE is not set
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y

# The EV1 rt-perf fragment removes the complete idle/sleep stack.  On MYD-LD25X
# that also breaks the SCMI regulator/eMMC boot path, so keep the board power
# domains and PSCI idle driver available.  Idle states are disabled at runtime
# for latency testing instead.
CONFIG_SUSPEND=y
CONFIG_SUSPEND_FREEZER=y
CONFIG_HIBERNATE_CALLBACKS=y
CONFIG_HIBERNATION=y
CONFIG_PM_SLEEP=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_SLEEP=y
CONFIG_CPU_PM=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=y
CONFIG_CPU_IDLE_GOV_LADDER=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_DT_IDLE_STATES=y
CONFIG_DT_IDLE_GENPD=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y

# Keep the release string reproducible after Yocto applies the RT patch set.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
